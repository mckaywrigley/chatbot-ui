{
  "name": "chatbot-ui",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "chat": "supabase start && npm run db-types && npm run dev",
    "restart": "supabase stop && npm run chat",
    "update": "git pull origin main && npm run db-migrate && npm run db-types",
    "prepare": "husky install",
    "clean": "npm run lint:fix && npm run format:write",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "analyze": "ANALYZE=true npm run build",
    "preview": "next build && next start",
    "type-check": "tsc --noEmit",
    "format:write": "prettier --write \"{app,lib,db,components,context,types}/**/*.{ts,tsx}\" --cache",
    "format:check": "prettier --check \"{app,lib,db,components,context,types}**/*.{ts,tsx}\" --cache",
    "db-reset": "supabase db reset && npm run db-types",
    "db-migrate": "supabase migration up && npm run db-types",
    "db-types": "supabase gen types typescript --db-url \"postgresql://postgres:postgres@localhost:54322/postgres?sslmode=disable\" --schema public,storage,graphql_public > supabase/types.ts",
    "db-pull": "supabase db remote commit",
    "db-prod-push": "supabase db push",
    "db-push": "supabase db push",
    "test": "jest",
    "qa": "playwright test --config e2e/playwright.config.ts",
    "qa:smoke": "playwright test --config e2e/playwright.config.ts --project=smoke",
    "qa:pipeline": "playwright test --config e2e/playwright.config.ts --project=pipeline",
    "qa:report": "playwright show-report playwright-report",
    "qa:digest": "node e2e/reporter/send-digest.mjs e2e-results.json"
  },
